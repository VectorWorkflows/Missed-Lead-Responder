# ============================================================================
#  MISSED-LEAD RESPONDER - environment
#  Copy to .env and fill in. NEVER commit .env.
# ============================================================================

# --- Public URL Twilio calls (no trailing slash) ----------------------------
PUBLIC_BASE_URL=https://lead.vectorworkflows.com

# --- Database (Atlas) -------------------------------------------------------
# THIS IS THE ONLY PLACE THE DATABASE IS CHOSEN.
# docker-compose.yml no longer sets MONGO_URI, and there is no local mongo
# container any more. Keep your existing Atlas string exactly as it is.
MONGO_URI=mongodb+srv://USER:PASSWORD@leadresponder.ulmpa5a.mongodb.net/?retryWrites=true&w=majority&appName=LeadResponder
MONGO_DB_NAME=missed_call_responder
DATA_DIR=/data

# --- Twilio -----------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_VALIDATE_SIGNATURE=true

# Your number belongs to a Messaging Service, so outbound SMS goes through it.
# This is also what carries the A2P campaign registration once approved.
TWILIO_MESSAGING_SERVICE_SID=MGe6c28f40d5e697597b3e480092d6f34e

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPS_TELEGRAM_CHAT_ID=7670860583

# --- Google Sheets ----------------------------------------------------------
# base64 of your service account JSON:  base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# ============================================================================
#  SAFETY NET - the reason a caller can never again hear
#  "this number is currently unavailable" because of an infrastructure problem.
#  Used only if Atlas is unreachable AND the on-disk snapshot is gone.
# ============================================================================
FALLBACK_ENABLED=true
FALLBACK_CLIENT_ID=vector_workflows
FALLBACK_BUSINESS_NAME=Vector Workflows
FALLBACK_TWILIO_NUMBER=+14704706323
FALLBACK_BOOKING_URL=https://cal.com/vectorworkflows/meeting-for-caller
FALLBACK_INTAKE_URL=https://tally.so/r/0QRgZN
FALLBACK_WEBSITE_URL=https://vectorworkflows.com
FALLBACK_TELEGRAM_CHAT_ID=7670860583
FALLBACK_SHEET_ID=1Gr7dpsX2MF-zmdYLVNnBnYsDUYc1sbLRrKCuSWwQ4Cw
FALLBACK_TIMEZONE=Asia/Kolkata
FALLBACK_FOR_UNKNOWN_NUMBERS=true

# ----------------------------------------------------------------------------
#  THE HONESTY SWITCH
#  false = the IVR NEVER promises a text. Callers get voicemail, a callback,
#          and your website. Set this while A2P/toll-free is unapproved -
#          promising a text that never arrives is worse than not offering one.
#  true  = full "press 2 / press 3 and we'll text you the link" menu.
#  Per-client `sms_enabled` in client_configs overrides this.
# ----------------------------------------------------------------------------
FALLBACK_SMS_ENABLED=false

# --- Behaviour --------------------------------------------------------------
LOG_LEVEL=INFO
CLIENT_CACHE_REFRESH_SECONDS=60
SMS_LOOKBACK_DAYS=14
ENABLE_SCHEDULER=true
FOLLOWUP_AFTER_HOURS=2
FOLLOWUP_HOUR_LOCAL=9
OWNER_REMINDER_AFTER_HOURS=4
ENABLE_HEARTBEAT=true
HEARTBEAT_HOUR_LOCAL=9
